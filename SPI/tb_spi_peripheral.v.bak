`timescale 1ns / 1ps

module tb_spi_peripheral;

    // Parâmetros
    parameter CLK_PERIOD = 10;
    parameter DATA_WIDTH = 8;

    // Sinais
    reg         clk;
    reg         rst_n;
    reg         cs_n;
    reg         sclk;
    reg         mosi;
    wire        miso;
    wire [DATA_WIDTH-1:0] data_out;
    reg  [DATA_WIDTH-1:0] data_in;

    // Instância DUT
    spi_peripheral #(
        .DATA_WIDTH(DATA_WIDTH)
    ) dut (
        .clk      (clk),
        .rst_n    (rst_n),
        .cs_n     (cs_n),
        .sclk     (sclk),
        .mosi     (mosi),
        .miso     (miso),
        .data_out (data_out),
        .data_in  (data_in)
    );

    // Clock
    initial clk = 0;
    always #(CLK_PERIOD/2) clk = ~clk;

    // Tarefa: enviar um byte serialmente (modo 0: CPOL=0, CPHA=0)
    task send_byte(input [DATA_WIDTH-1:0] byte);
        integer i;
        begin
            cs_n = 0;
            repeat (2) @(posedge clk);
            for (i = DATA_WIDTH-1; i >= 0; i = i - 1) begin
                mosi = byte[i];
                @(posedge clk);
            end
            repeat (2) @(posedge clk);
            cs_n = 1;
        end
    endtask

    // Tarefa: verificar byte recebido
    task check_byte(input [DATA_WIDTH-1:0] expected, input [DATA_WIDTH-1:0] actual, input string msg);
        begin
            if (actual === expected)
                $display("[PASS] %s: 0x%02h", msg, actual);
            else
                $display("[FAIL] %s: esperado 0x%02h, obtido 0x%02h", msg, expected, actual);
        end
    endtask

    // Teste principal
    initial begin
        // Reset
        rst_n  = 0;
        cs_n   = 1;
        sclk   = 0;
        mosi   = 0;
        data_in = 8'h00;
        repeat (4) @(posedge clk);
        rst_n = 1;
        repeat (2) @(posedge clk);

        $display("  TB SPI Peripheral - Início dos testes");

        // Teste 1: Enviar 0xFF
        $display("\n[TEST 1] Enviando 0xFF");
        data_in = 8'hFF;
        send_byte(8'hFF);
        check_byte(8'hFF, data_out, "Teste 1");

        // Teste 2: Enviar 0xA5
        $display("\n[TEST 2] Enviando 0xA5");
        data_in = 8'hA5;
        send_byte(8'hA5);
        check_byte(8'hA5, data_out, "Teste 2");

        // Teste 3: Enviar 0x00
        $display("\n[TEST 3] Enviando 0x00");
        data_in = 8'h00;
        send_byte(8'h00);
        check_byte(8'h00, data_out, "Teste 3");

        // Teste 4: Enviar 0x5A
        $display("\n[TEST 4] Enviando 0x5A");
        data_in = 8'h5A;
        send_byte(8'h5A);
        check_byte(8'h5A, data_out, "Teste 4");

        // Teste 5: Múltiplos bytes em sequência
        $display("\n[TEST 5] Sequência de bytes");
        data_in = 8'h12;
        send_byte(8'h12);
        check_byte(8'h12, data_out, "Teste 5a");

        data_in = 8'h34;
        send_byte(8'h34);
        check_byte(8'h34, data_out, "Teste 5b");

        data_in = 8'h56;
        send_byte(8'h56);
        check_byte(8'h56, data_out, "Teste 5c");

        // Teste 6: CS alto (desabilitado)
        $display("\n[TEST 6] CS desabilitado");
        data_in = 8'hDE;
        cs_n = 0;
        repeat (2) @(posedge clk);
        cs_n = 1;
        repeat (4) @(posedge clk);
        $display("[INFO] CS alto: dados não devem ser atualizados");
        $display("       data_out = 0x%02h (deve ser 0x56 do teste anterior)", data_out);

        $display("  Fim dos testes");
        #100;
        $finish;
    end

    // Monitor de sinais
    initial begin
        $dumpfile("tb_spi_peripheral.vcd");
        $dumpvars(0, tb_spi_peripheral);
    end

endmodule   