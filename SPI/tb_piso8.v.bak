`timescale 1ns/1ps

module tb_piso8;

	reg clk = 0;
	reg clr_n;
	reg load;
	reg shift;
	reg[7:0] parallel_in;
	wire serial_out;
	
	piso8 (
	.clk(clk),
	.clr_n(clr_n),
	.load(load),
	.shift(shift),
	.parallel_in(parallel_in),
	.serial_out(serial_out)
	);

	// clock ns == 100Mhz
	always #5 clk = ~clk;
	
	reg [7:0] carga;
	integer i;
	
	initial begin 
	
	$dumpfile ("tb_piso8.vcd");
	$dumpvars (0, tb_piso8);
	
	// estado inicial e reset
	
	clr = 0; 
	load = 0;
	shift = 0;
	parallel_in = 8'h00;
	
	// Carregar entrada
	carga = 8'hA5;
	
	@(negedeg clk);
	parallel_in = carga;
	load = 1;
	@(negedeg clk);
	load = 0;
	